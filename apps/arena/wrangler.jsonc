/**
 * Arena worker: MatchmakerDO, RoomDO, the version-checks Queue consumer, spectator WebSockets
 * (`ShowcaseEntrypoint`, reached only by apps/web's `SHOWCASE` service binding; ShowcaseDO picks
 * the room) and later MCP. Top level is local dev (`pnpm dev`);
 * `env.staging` is what CI deploys to api.zerosnake.dev (the only public environment for now).
 *
 * Bindings are not inherited by environments, so every binding is declared twice.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerosnake-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Bundles the house bots into src/house-bundles.gen.ts (git-ignored) before dev and deploy.
  "build": { "command": "node scripts/house-bundles.ts", "watch_dir": "../../bots/house/src" },
  // CPU time per invocation, the plan maximum; repeated in `env.staging`. The checks consumer
  // needs it: in workerd the suite's own time cap never fires, so a slow bot is stopped only by
  // this limit, and queue consumers default to 30 s (`packages/checks/README.md`, "Runtime").
  "limits": { "cpu_ms": 300000 },

  // Shared by all environments.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchmakerDO", "RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ShowcaseDO"] }
  ],

  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [
    // Same database as apps/web. Local ID is arbitrary but must match apps/web.
    { "binding": "DB", "database_name": "zerosnake-dev", "database_id": "zerosnake-dev" }
  ],
  "r2_buckets": [
    { "binding": "BUNDLES", "bucket_name": "zerosnake-dev-bundles" },
    { "binding": "SOURCES", "bucket_name": "zerosnake-dev-sources" },
    { "binding": "REPLAYS", "bucket_name": "zerosnake-dev-replays" },
    { "binding": "TRACES", "bucket_name": "zerosnake-dev-traces" }
  ],
  // Checks consumer (src/checks.ts): one job per batch, as each holds a sandbox of up to 64 MiB.
  // After the last retry a job goes to the DLQ, whose consumer rejects the version.
  "queues": {
    "producers": [{ "binding": "CHECKS_QUEUE", "queue": "zerosnake-dev-checks" }],
    "consumers": [
      {
        "queue": "zerosnake-dev-checks",
        "max_batch_size": 1,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "zerosnake-dev-checks-dlq"
      },
      // Jobs out of retries (CPU limit, or R2/D1 errors): their versions are rejected.
      { "queue": "zerosnake-dev-checks-dlq", "max_batch_size": 10 }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "SHOWCASE", "class_name": "ShowcaseDO" }
    ]
  },
  // Metrics (`@zerosnake/observability`): one Analytics Engine dataset per environment, shared
  // with apps/web. Without the binding nothing is written.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "zerosnake_dev" }],
  // Rejects versions whose check job was lost (`reapStaleVersions`). Inherited by environments.
  "triggers": { "crons": ["*/30 * * * *"] },

  "env": {
    "staging": {
      // Deployed as `zerosnake-arena-staging`.
      "routes": [{ "pattern": "api.zerosnake.dev", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "staging" },
      "limits": { "cpu_ms": 300000 },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zerosnake-staging",
          "database_id": "d2d6929c-498c-4224-8cc5-b7aad4a4c3ec"
        }
      ],
      "r2_buckets": [
        { "binding": "BUNDLES", "bucket_name": "zerosnake-staging-bundles" },
        { "binding": "SOURCES", "bucket_name": "zerosnake-staging-sources" },
        { "binding": "REPLAYS", "bucket_name": "zerosnake-staging-replays" },
        { "binding": "TRACES", "bucket_name": "zerosnake-staging-traces" }
      ],
      "queues": {
        "producers": [{ "binding": "CHECKS_QUEUE", "queue": "zerosnake-staging-checks" }],
        "consumers": [
          {
            "queue": "zerosnake-staging-checks",
            "max_batch_size": 1,
            "max_retries": 3,
            "retry_delay": 10,
            "dead_letter_queue": "zerosnake-staging-checks-dlq"
          },
          // Jobs out of retries (CPU limit, or R2/D1 errors): their versions are rejected.
          { "queue": "zerosnake-staging-checks-dlq", "max_batch_size": 10 }
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
          { "name": "ROOMS", "class_name": "RoomDO" },
          { "name": "SHOWCASE", "class_name": "ShowcaseDO" }
        ]
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "zerosnake_staging" }]
    }
  }
}

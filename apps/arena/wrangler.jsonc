/**
 * Arena worker: MatchmakerDO, RoomDO, the version-checks Queue consumer, and later spectator
 * WebSockets and MCP. Top level is local dev (`pnpm dev`); `env.staging` is what CI deploys
 * to api.arena.surninsynergy.dev.
 *
 * Bindings are not inherited by environments, so every binding is declared twice.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerosnake-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Bundles the house bots into src/house-bundles.gen.ts (git-ignored) before dev and deploy.
  "build": { "command": "node scripts/house-bundles.ts", "watch_dir": "../../bots/house/src" },

  // Shared by all environments.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchmakerDO", "RoomDO"] }],

  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [
    // Same database as apps/web. Local ID is arbitrary but must match apps/web.
    { "binding": "DB", "database_name": "zerosnake-dev", "database_id": "zerosnake-dev" }
  ],
  "r2_buckets": [
    { "binding": "BUNDLES", "bucket_name": "zerosnake-dev-bundles" },
    { "binding": "SOURCES", "bucket_name": "zerosnake-dev-sources" },
    { "binding": "REPLAYS", "bucket_name": "zerosnake-dev-replays" },
    { "binding": "TRACES", "bucket_name": "zerosnake-dev-traces" }
  ],
  "queues": {
    "producers": [{ "binding": "CHECKS_QUEUE", "queue": "zerosnake-dev-checks" }],
    "consumers": [
      {
        "queue": "zerosnake-dev-checks",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "zerosnake-dev-checks-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
      { "name": "ROOMS", "class_name": "RoomDO" }
    ]
  },

  "env": {
    "staging": {
      // Deployed as `zerosnake-arena-staging`.
      "routes": [{ "pattern": "api.arena.surninsynergy.dev", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zerosnake-staging",
          "database_id": "d2d6929c-498c-4224-8cc5-b7aad4a4c3ec"
        }
      ],
      "r2_buckets": [
        { "binding": "BUNDLES", "bucket_name": "zerosnake-staging-bundles" },
        { "binding": "SOURCES", "bucket_name": "zerosnake-staging-sources" },
        { "binding": "REPLAYS", "bucket_name": "zerosnake-staging-replays" },
        { "binding": "TRACES", "bucket_name": "zerosnake-staging-traces" }
      ],
      "queues": {
        "producers": [{ "binding": "CHECKS_QUEUE", "queue": "zerosnake-staging-checks" }],
        "consumers": [
          {
            "queue": "zerosnake-staging-checks",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "zerosnake-staging-checks-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
          { "name": "ROOMS", "class_name": "RoomDO" }
        ]
      }
    }
  }
}

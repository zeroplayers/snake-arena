# Copy to .dev.vars (gitignored) for `pnpm dev`. Staging gets the same names via
# `wrangler secret put <NAME> --env staging`. Never commit real values.

# Random string, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers → New OAuth App), one per environment:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

{
  "name": "@zerosnake/web",
  "version": "0.0.0",
  "private": true,
  "description": "Site: TanStack Start on Workers",
  "type": "module",
  "exports": {
    "./shared": "./src/shared/index.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types >/dev/null && tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "db:seed": "wrangler d1 execute DB --local --persist-to ../../.wrangler/state --file seed/dev.sql && node --experimental-transform-types --no-warnings seed/pages.ts",
    "db:reset": "rm -rf ../../.wrangler/state/v3/d1 && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@zerosnake/engine": "workspace:*",
    "@zerosnake/renderer": "workspace:*",
    "@zerosnake/viewer": "workspace:*",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zerosnake/house-bots": "workspace:*",
    "@zerosnake/sdk": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "markdown-it": "^15.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}

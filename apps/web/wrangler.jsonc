/**
 * Site worker. Top level is local dev (`pnpm dev`, everything simulated by Miniflare);
 * `env.staging` is what CI deploys to staging.zerosnake.dev.
 *
 * Bindings are not inherited by environments, so every binding is declared twice.
 *
 * AUTH_KV (web sessions) is bound here only, never in apps/arena/wrangler.jsonc: apps/arena runs
 * untrusted bot code and shares the D1 database, so session tokens are kept out of both.
 *
 * Secrets (BETTER_AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET) are not in this file:
 * `.dev.vars` locally (see `.dev.vars.example`), `wrangler secret put --env staging` on staging.
 *
 * Limits, kill switch and observability: see "Operations" in README.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerosnake-web",
  // Edge checks + TanStack Start, and the Cron Trigger (src/server.ts).
  "main": "src/server.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs: structured request logs (src/server/edge.ts) and invocation logs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  // Rating job every minute (src/server/ratings.ts), arena liveness check and revoked session
  // pruning every five (src/server/liveness.ts, session-store.ts), replay retention sweep every
  // thirty (src/server/replays.ts); src/server.ts dispatches on the expression. Locally:
  // curl "http://localhost:3000/cdn-cgi/handler/scheduled?cron=*+*+*+*+*" (or ?cron=*/5+*+*+*+*,
  // ?cron=*/30+*+*+*+*).
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "*/30 * * * *"] },

  // DEPLOYS_PER_DAY and BOTS_PER_AUTHOR override the CLI API's defaults (src/shared/deploy.ts).
  // ADMIN_USER_IDS / ADMIN_GITHUB_IDS: comma-separated admins for /admin (src/server/moderation.ts);
  // GitHub ids are numeric (`gh api users/<login> --jq .id`), never logins.
  // NO_LIVES_ALERT_MINUTES: how long without lives the liveness check calls the arena stalled.
  // CF_BEACON_TOKEN: Cloudflare Web Analytics site token (public, not a secret; see README
  // "Web Analytics"). Empty: no analytics. Never loaded while ENVIRONMENT is development.
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_URL": "http://localhost:3000",
    "DEPLOYS_PER_DAY": "20",
    "BOTS_PER_AUTHOR": "3",
    "ADMIN_USER_IDS": "",
    "ADMIN_GITHUB_IDS": "",
    "NO_LIVES_ALERT_MINUTES": "15",
    "CF_BEACON_TOKEN": ""
  },
  // Rate limits (src/server/rate-limit.ts; RATE_LIMITS there must match, a test checks).
  // namespace_id: any integer unique in the Cloudflare account; nothing to create.
  "ratelimits": [
    { "name": "RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_USER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_DEPLOY", "namespace_id": "1004", "simple": { "limit": 6, "period": 60 } }
  ],
  // Metrics (@zerosnake/observability). The dataset is made by the first write.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "zerosnake_dev" }],
  "d1_databases": [
    // Same database as apps/arena. Local ID is arbitrary but must match apps/arena.
    // Migrations live here (src/db/schema.ts → `pnpm db:generate`) and are applied from here.
    {
      "binding": "DB",
      "database_name": "zerosnake-dev",
      "database_id": "zerosnake-dev",
      "migrations_dir": "migrations"
    }
  ],
  // Better Auth web sessions (src/server/session-store.ts). Local id is arbitrary.
  "kv_namespaces": [{ "binding": "AUTH_KV", "id": "zerosnake-dev-auth" }],
  "r2_buckets": [
    { "binding": "BUNDLES", "bucket_name": "zerosnake-dev-bundles" },
    { "binding": "SOURCES", "bucket_name": "zerosnake-dev-sources" },
    { "binding": "REPLAYS", "bucket_name": "zerosnake-dev-replays" },
    { "binding": "TRACES", "bucket_name": "zerosnake-dev-traces" }
  ],
  "queues": {
    // Deploy API enqueues version checks; apps/arena consumes them.
    "producers": [{ "binding": "CHECKS_QUEUE", "queue": "zerosnake-dev-checks" }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO", "script_name": "zerosnake-arena" },
      { "name": "ROOMS", "class_name": "RoomDO", "script_name": "zerosnake-arena" }
    ]
  },
  "services": [
    { "binding": "ARENA", "service": "zerosnake-arena" },
    // The live showcase's WebSockets (src/server/showcase.ts): a named entrypoint of the arena
    // Worker that has no public URL, so spectators come only through this site.
    { "binding": "SHOWCASE", "service": "zerosnake-arena", "entrypoint": "ShowcaseEntrypoint" }
  ],

  "env": {
    "staging": {
      // Deployed as `zerosnake-web-staging`.
      "routes": [{ "pattern": "staging.zerosnake.dev", "custom_domain": true }],
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *", "*/30 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "BETTER_AUTH_URL": "https://staging.zerosnake.dev",
        "DEPLOYS_PER_DAY": "20",
        "BOTS_PER_AUTHOR": "3",
        "ADMIN_USER_IDS": "",
        "ADMIN_GITHUB_IDS": "",
        "NO_LIVES_ALERT_MINUTES": "15",
        "CF_BEACON_TOKEN": ""
      },
      "ratelimits": [
        {
          "name": "RATE_LIMIT_IP",
          "namespace_id": "2001",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_AUTH",
          "namespace_id": "2002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_USER",
          "namespace_id": "2003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_DEPLOY",
          "namespace_id": "2004",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "zerosnake_staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zerosnake-staging",
          "database_id": "d2d6929c-498c-4224-8cc5-b7aad4a4c3ec",
          "migrations_dir": "migrations"
        }
      ],
      // `wrangler kv namespace create zerosnake-staging-auth` (see README "Staging").
      "kv_namespaces": [{ "binding": "AUTH_KV", "id": "17570618d89f4dbf90c5b691193a14bb" }],
      "r2_buckets": [
        { "binding": "BUNDLES", "bucket_name": "zerosnake-staging-bundles" },
        { "binding": "SOURCES", "bucket_name": "zerosnake-staging-sources" },
        { "binding": "REPLAYS", "bucket_name": "zerosnake-staging-replays" },
        { "binding": "TRACES", "bucket_name": "zerosnake-staging-traces" }
      ],
      "queues": {
        "producers": [{ "binding": "CHECKS_QUEUE", "queue": "zerosnake-staging-checks" }]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "MATCHMAKER",
            "class_name": "MatchmakerDO",
            "script_name": "zerosnake-arena-staging"
          },
          { "name": "ROOMS", "class_name": "RoomDO", "script_name": "zerosnake-arena-staging" }
        ]
      },
      "services": [
        { "binding": "ARENA", "service": "zerosnake-arena-staging" },
        {
          "binding": "SHOWCASE",
          "service": "zerosnake-arena-staging",
          "entrypoint": "ShowcaseEntrypoint"
        }
      ]
    }
  }
}

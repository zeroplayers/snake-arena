{
  "name": "zerosnake",
  "version": "0.1.2",
  "description": "ZeroSnake Arena CLI: create a snake bot, play it locally, deploy it to the arena",
  "keywords": [
    "zerosnake",
    "snake",
    "slither.io",
    "bot",
    "game-ai",
    "programming-game",
    "ai-arena",
    "claude-code",
    "quickjs"
  ],
  "homepage": "https://zerosnake.dev",
  "bugs": {
    "url": "https://github.com/zeroplayers/snake-arena/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroplayers/snake-arena.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Surnin Synergy Ltd <hello@surninsynergy.com>",
  "type": "module",
  "bin": {
    "zerosnake": "./bin/zerosnake.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "margin": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/margin.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "esbuild": "0.28.2",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@zerosnake/checks": "workspace:*",
    "@zerosnake/engine": "workspace:*",
    "@zerosnake/house-bots": "workspace:*",
    "@zerosnake/renderer": "workspace:*",
    "@zerosnake/sandbox": "workspace:*",
    "@zerosnake/sdk": "workspace:*",
    "@zerosnake/viewer": "workspace:*",
    "@zerosnake/web": "workspace:*",
    "vitest": "^5.0.5"
  }
}
